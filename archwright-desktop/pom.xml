<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.arthursouto</groupId>
        <artifactId>archwright-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>archwright-desktop</artifactId>
    <name>Archwright Desktop</name>
    <description>App JavaFX + AtlantaFX que só coleta escolhas e chama o engine (ADR-0002).</description>

    <properties>
        <javafx.version>27.0.1</javafx.version>
        <atlantafx.version>3.0.0</atlantafx.version>
        <exec-maven-plugin.version>3.7.0</exec-maven-plugin.version>
        <desktop.main-class>io.github.arthursouto.archwright.desktop.Launcher</desktop.main-class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.arthursouto</groupId>
            <artifactId>archwright-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <configuration>
                    <mainClass>${desktop.main-class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
