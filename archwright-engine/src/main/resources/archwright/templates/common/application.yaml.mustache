spring:
  application:
    name: {{artifactId}}
{{#dep.web}}
{{^boot.spring61}}
  mvc:
    throw-exception-if-no-handler-found: true
  web:
    resources:
      add-mappings: false
{{/boot.spring61}}
{{/dep.web}}
{{#dep.jpa}}
  datasource:
    url: ${DATASOURCE_URL:jdbc:postgresql://localhost:5433/{{database.name}}?sslmode=disable}
    username: ${DATASOURCE_USERNAME:app}
    password: ${DATASOURCE_PASSWORD:app}
  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: {{#dep.flyway}}validate{{/dep.flyway}}{{^dep.flyway}}none{{/dep.flyway}}
{{/dep.jpa}}

server:
  port: ${SERVER_PORT:8080}
{{#dep.actuator}}

management:
  endpoints:
    web:
      exposure:
        include: health
{{/dep.actuator}}
